# tools/build — compile application modules (backend, middleware, frontend).

set shell := ["bash", "-c"]

# Build all modules
[no-cd]
all: backend middleware frontend

[no-cd]
backend:
    cmake -S backend -B backend/build -DCMAKE_BUILD_TYPE=Release && cmake --build backend/build -j

[no-cd]
middleware:
    cd middleware && uv build

[no-cd]
frontend:
    cd frontend && npm run build
