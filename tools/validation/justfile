# tools/validation — run application module linters/formatters.

set shell := ["bash", "-c"]

# Run all linters
[no-cd]
all: backend middleware frontend

[no-cd]
backend:
    @if command -v clang-format >/dev/null 2>&1; then \
        find backend/src backend/include backend/test -name '*.cpp' -o -name '*.hpp' -o -name '*.h' | xargs clang-format --dry-run --Werror; \
    else \
        echo "clang-format not installed, skipping C++ backend linting."; \
    fi

[no-cd]
middleware:
    cd middleware && uv run ruff check . && uv run ruff format --check .

[no-cd]
frontend:
    cd frontend && npm run lint
