# tools/dev — environment setup and maintenance.

set shell := ["bash", "-c"]

# Set up environment for all modules
[no-cd]
setup:
    @echo "Setting up dev environment..."
    cd middleware && uv sync --all-extras --dev
    cd frontend && npm ci
    pip install pre-commit || true
    pre-commit install --install-hooks || echo "pre-commit not available"
    @echo "Setup complete. Run 'just test-all' to verify."

# Update all dependencies
[no-cd]
update:
    @echo "Updating dependencies..."
    cd middleware && uv sync --upgrade
    cd frontend && npm update

# Run pre-commit hooks manually
[no-cd]
pre-commit:
    pre-commit run --all-files

# Clean build artifacts across every module
[no-cd]
clean:
    rm -rf middleware/.pytest_cache middleware/.ruff_cache middleware/.mypy_cache middleware/**/__pycache__
    rm -rf frontend/dist frontend/node_modules/.cache frontend/src-tauri/target
    rm -rf backend/build
