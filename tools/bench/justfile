# tools/bench — run benchmarks across application modules.

set shell := ["bash", "-c"]

[no-cd]
all: backend middleware

[no-cd]
backend:
    cmake -S backend -B backend/build -DCMAKE_BUILD_TYPE=Release && cmake --build backend/build --target benchmark -j && ./backend/build/benchmark/benchmark

[no-cd]
middleware:
    cd middleware && uv run pytest benchmark --benchmark-only
