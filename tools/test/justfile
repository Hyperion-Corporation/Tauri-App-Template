# tools/test — run application module test suites.

set shell := ["bash", "-c"]

# Run all test suites
[no-cd]
all: backend middleware frontend

[no-cd]
backend:
    cmake -S backend -B backend/build -DBUILD_TESTING=ON && cmake --build backend/build -j && ctest --test-dir backend/build --output-on-failure

[no-cd]
middleware:
    cd middleware && uv run pytest test -v

[no-cd]
frontend:
    cd frontend && npm test
