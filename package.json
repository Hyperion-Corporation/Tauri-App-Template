{
    "name": "tauri-app-template-root",
    "private": true,
    "description": "Root workspace manifest for Tauri-App-Template. The TypeScript/Tauri frontend lives in frontend/.",
    "scripts": {
        "dev": "npm run dev --prefix frontend",
        "build": "npm run build --prefix frontend",
        "lint": "npm run lint --prefix frontend",
        "test": "npm run test --prefix frontend",
        "tauri:dev": "npm run tauri:dev --prefix frontend",
        "tauri:build": "npm run tauri:build --prefix frontend",
        "install:all": "npm install && npm install --prefix frontend"
    },
    "workspaces": [
        "frontend"
    ]
}
